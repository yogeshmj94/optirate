# Database connection strings for Neon serverless Postgres on Vercel.
# 
# DATABASE_URL: Pooled connection string from Neon (via PgBouncer).
#   - Used by Prisma Client at runtime for queries.
#   - Supports serverless functions and high concurrency.
#   - Do NOT use for migrations (PgBouncer does not support DDL).
#
# DIRECT_URL: Direct, unpooled connection string from Neon.
#   - Used ONLY by Prisma for schema migrations (`prisma migrate deploy`).
#   - Required in schema.prisma as `directUrl = env("DIRECT_URL")`.
#   - Run migrations manually before/after Vercel deployments.
#
# To set up Neon for this project:
#   1. Create a free project at https://console.neon.tech
#   2. Copy both connection strings from the Neon dashboard
#   3. Add these variables to Vercel: Project Settings → Environment Variables
#
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require"

MOCK_SETU=true
SETU_KYC_BASE_URL=""
SETU_KYC_CLIENT_ID=""
SETU_KYC_CLIENT_SECRET=""
SETU_PAN_INSTANCE_ID=""
SETU_AA_CLIENT_ID=""
SETU_AA_CLIENT_SECRET=""
